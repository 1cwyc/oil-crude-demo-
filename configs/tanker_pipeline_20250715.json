{
  "pipeline_name": "AIS tanker pilot 2025-07-15",
  "output_root": "F:\\AIS\\output\\tanker_2025-07-15",
  "date_range": {
    "from": "2025-07-15",
    "to": "2025-07-15"
  },
  "input_patterns": {
    "sta": "F:\\AIS\\STA_OK_{date}.dat",
    "pos": "F:\\AIS\\POS_OK_{date}.dat"
  },
  "tanker_classification": {
    "policy": "any_observed",
    "ship_types": [80, 81, 82, 83, 84, 85, 86, 87, 88, 89],
    "note": "2025-07-15 pilot explicitly includes all AIS ship types 80-89 at user request; verify provider convention before formal research."
  },
  "sampling": {
    "timezone": "UTC",
    "hours": [0, 3, 6, 9, 12, 15, 18, 21],
    "tolerance_seconds": 1800,
    "require_complete_window": false
  },
  "quality": {
    "exclude_zero_zero": true
  },
  "duckdb": {
    "memory_limit": "12GB",
    "threads": 4,
    "temp_directory": "F:\\AIS\\output\\tanker_2025-07-15\\_tmp"
  },
  "export_csv_on_run": true,
  "heatmap_on_run": true,
  "heatmap": {
    "metric": "sample_count",
    "extent": [-180.0, 180.0, -90.0, 90.0],
    "bin_size_degrees": 0.5,
    "colormap": "inferno",
    "dpi": 180,
    "figure_size_inches": [14, 7]
  }
}
